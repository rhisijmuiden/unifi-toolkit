[Unit]
Description=UniFi Toolkit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toolkit
Group=toolkit
WorkingDirectory=/opt/unifi-toolkit
ExecStart=/opt/unifi-toolkit/.venv/bin/python run.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
ProtectSystem=full
ReadWritePaths=/var/lib/unifi-toolkit /opt/unifi-toolkit

[Install]
WantedBy=multi-user.target
